# Секреты и креды
.env
.env.*
*.session
session.session
anon_session.session
qr_token.txt
pending_code_hash.txt
# OpenClaw runtime configuration (never commit)
openclaw.json
openclaw.json.*
openclaw-workspace-state.json

# Папки, не для репозитория
_trash/
_trash_/
media/
calendar/anon_session.session
tg-mtproto/
node_modules/
# Extra-agent OpenClaw workspaces (runtime, not source). Stock name is
# workspace-chat; keep the glob so workspace-opus/etc. never get committed.
workspace-chat/
workspace-*/

# Логи и временное
*.log
*.log.*
*.tmp
.DS_Store

# Python
__pycache__/
*.pyc

# Python venv
venv/
.venv/
.clawpatch/

# Runtime data (не для git)
*.db
*.sqlite
travel/am_captcha*.jpg
credentials
*.key
*.token
session*
/memory/MEMORY-fat-*.md
/memory/.dreams/
/memory/dreaming/
/memory/*.md
/reports/*.xlsx

travel/*_state.json
/hub/**/*.json
/hub/**/*.jsonl
/hub/memory/
/hub/*.session*

# OpenClaw backup archives (238MB, 0600) — never commit
*openclaw-backup.tar.gz
# Local scratch / archived material
_scratch/
_archive/
_tmp_*
