#!/usr/bin/env python3
"""Bounded web-search settings operator for the owner-controlled main agent."""
import json
import subprocess
import sys

OPENCLAW = "/usr/bin/openclaw"
PROVIDERS = {"searxng", "parallel-free", "parallel"}


def deny(message: str) -> None:
    print(f"web-tools operator: denied: {message}", file=sys.stderr)
    raise SystemExit(2)


def call(*args: str) -> int:
    return subprocess.run([OPENCLAW, *args], check=False).returncode


def set_value(path: str, value: str) -> None:
    if call("config", "set", path, value, "--strict-json") != 0:
        raise SystemExit(1)
    raise SystemExit(call("config", "validate"))


def integer(value: str, low: int, high: int, label: str) -> int:
    try:
        result = int(value)
    except ValueError:
        deny(f"{label} must be an integer")
    if not low <= result <= high:
        deny(f"{label} must be between {low} and {high}")
    return result


def config_value(path: str) -> str:
    result = subprocess.run([OPENCLAW, "config", "get", path], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def main(argv: list[str]) -> None:
    if not argv:
        deny("usage: status | provider <searxng|parallel-free|parallel> | max-results <1..20> | timeout <5..60> | cache-ttl <0..60> | validate")
    cmd, *rest = argv
    if cmd == "status" and not rest:
        print(json.dumps({
            "provider": config_value("tools.web.search.provider"),
            "maxResults": config_value("tools.web.search.maxResults"),
            "timeoutSeconds": config_value("tools.web.search.timeoutSeconds"),
            "cacheTtlMinutes": config_value("tools.web.search.cacheTtlMinutes"),
        }, ensure_ascii=False))
        return
    if cmd == "validate" and not rest:
        raise SystemExit(call("config", "validate"))
    if cmd == "provider" and len(rest) == 1:
        if rest[0] not in PROVIDERS:
            deny("provider is not approved")
        set_value("tools.web.search.provider", json.dumps(rest[0]))
    if cmd == "max-results" and len(rest) == 1:
        set_value("tools.web.search.maxResults", str(integer(rest[0], 1, 20, "max-results")))
    if cmd == "timeout" and len(rest) == 1:
        set_value("tools.web.search.timeoutSeconds", str(integer(rest[0], 5, 60, "timeout")))
    if cmd == "cache-ttl" and len(rest) == 1:
        set_value("tools.web.search.cacheTtlMinutes", str(integer(rest[0], 0, 60, "cache-ttl")))
    deny("unsupported command or arguments")


if __name__ == "__main__":
    main(sys.argv[1:])
