                        <button
                          onClick={(e) => { e.stopPropagation(); deleteTask(t.id); }}
                          className="text-slate-300 hover:text-red-500 text-sm font-black shrink-0 px-1"
                        >×</button>
                      </div>
                    </div>
                  ))}

                  {activeTasks.length === 0 && (
                    <div className="text-center py-4 text-xs text-slate-400">
