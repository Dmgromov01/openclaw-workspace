                    Сохранить пароль
                  </button>
                </div>
              )}

              {/* 1. Погода */}
              <div className="card-white rounded-3xl p-5 space-y-3">
                <div className="flex justify-between items-center">
                  <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wide">Погода</span>
                </div>

                <div className="flex items-center justify-between">
                  <div className="text-4xl font-black text-slate-900">{weather.temp}°C</div>
                  <div className="text-right">
                    <div className="flex items-center justify-end gap-2">
                      <img src={'weather-icons/meteocons/' + (weather.icon || 'cloudy') + '.svg'} alt="" className="w-11 h-11" />
                      <div className="text-base font-bold text-slate-800">{weather.condition}</div>
                    </div>
                    <div className="text-xs text-slate-500 mt-0.5">Ветер {weather.wind} • {weather.city}</div>
                  </div>
                </div>

                {/* Осадки по Москве (Open-Meteo): сейчас + ближайшие 12ч, визуализация мелкий дождь → ливень */}
                {om && om.hourly && (
                  <div className="pt-2 border-t border-slate-100 space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wide">Осадки в Москве · 12ч</span>
                      <span className="text-xs font-bold text-blue-600">{om.current ? (om.current.rain > 0 ? '💧 ' + om.current.rain.toFixed(1) + ' мм/ч' : om.current.snowfall > 0 ? '❄️ ' + om.current.snowfall.toFixed(1) + ' см' : 'сухо') : ''}</span>
                    </div>

                    {/* Ползунок: +0..+12 часов вперёд */}
                    <div className="flex items-center gap-2">
                      <input
                        type="range"
                        min="0"
                        max="12"
                        value={hourOffset}
                        onChange={e => setHourOffset(parseInt(e.target.value))}
                        className="flex-1 h-1.5 accent-blue-600"
                      />
                      <span className="text-[11px] font-bold text-slate-600 w-12 text-right whitespace-nowrap">+{hourOffset} ч</span>
                    </div>

                    <div className="flex gap-1.5 overflow-x-auto pb-1">
                      {(() => {
                        // старт окна: текущий час (не 00:00) + ползунок
                        const nowTs = Date.now();
                        let startIdx = om.hourly.time.findIndex(t => new Date(t).getTime() >= nowTs - 60 * 60 * 1000);
                        if (startIdx < 0) startIdx = 0;
                        return om.hourly.time.slice(startIdx + hourOffset, startIdx + hourOffset + 12).map((t, i) => {
                          const j = startIdx + hourOffset + i;
                          const r = om.hourly.rain?.[j] || 0;
                          const s = om.hourly.snowfall?.[j] || 0;
                          const wc = om.hourly.weathercode?.[j] ?? 0;
                          const total = r + s;
                          // иконка неба: сухо → по облачности (☀️/⛅/☁️), осадки → дождь/ливень
                          let icon;
                          if (total > 0) {
                            icon = total < 0.3 ? 'drizzle' : total < 3 ? 'rain' : 'thunderstorms';
                          } else {
                            icon = wc === 0 ? 'clear-day' : wc <= 2 ? 'partly-cloudy-day' : wc >= 95 ? 'thunderstorms' : wc >= 80 ? 'rain' : wc >= 71 ? 'snow' : wc >= 61 ? 'rain' : wc >= 51 ? 'drizzle' : wc >= 45 ? 'fog' : 'cloudy';
                          }
                          // визуализация: сухо → морось → мелкий → дождь → сильный → ливень
                          const lvl = total <= 0 ? 0 : total < 0.3 ? 1 : total < 1 ? 2 : total < 3 ? 3 : total < 6 ? 4 : 5;
                          const labels = ['сухо', 'морось', 'мелкий', 'дождь', 'сильный', 'ливень'];
                          const bg = ['bg-slate-50', 'bg-sky-100', 'bg-sky-200', 'bg-blue-200', 'bg-indigo-300', 'bg-red-300'];
                          const txt = ['text-slate-400', 'text-sky-700', 'text-sky-800', 'text-blue-900', 'text-indigo-900', 'text-red-900'];
                          return (
                            <div key={t} className={`flex-shrink-0 w-14 rounded-xl ${bg[lvl]} border border-slate-200 px-1 py-1.5 text-center`}>
                              <div className="text-[10px] font-bold text-slate-500">{new Date(t).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</div>
                              <img src={'weather-icons/meteocons/' + icon + '.svg'} alt="" className="w-7 h-7 mx-auto my-0.5" />
                              <div className={`text-[9px] font-bold ${txt[lvl]}`}>{s > 0 ? '❄ ' + s.toFixed(1) : labels[lvl]}</div>
                              <div className="text-xs font-black text-slate-800">{Math.round(om.hourly.temperature_2m[j])}°</div>
                              <div className="text-[9px] font-semibold text-slate-500">{Math.round(om.hourly.wind_speed_10m?.[j] || 0)} м/с</div>
                            </div>
                          );
                        });
                      })()}
                    </div>
                    <div className="text-[10px] text-slate-400 font-semibold text-center">Ползунок: прогноз на +12 часов · каждая ячейка: осадки, температура, ветер</div>
                  </div>
                )}
              </div>

              {/* 1.5. Google Календарь */}
              <div className="card-white rounded-3xl p-5 space-y-3">
                <div className="flex justify-between items-center">
                  <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wide">📅 Google Календарь</span>
                  <span className="text-[10px] font-bold text-slate-400">7 дней</span>
                </div>
                {calendarError ? (
                  <div className="text-xs text-red-500">{calendarError}</div>
                ) : !calendarData ? (
                  <div className="text-center py-2 text-xs text-slate-400">Загружаем события…</div>
                ) : (
                  <div className="space-y-2">
                    {calendarData.days && calendarData.days.filter(d => d.events.length > 0).length === 0 && (
                      <div className="text-center py-2 text-xs text-slate-400">На ближайшие 7 дней событий нет.</div>
                    )}
                    {calendarData.days && calendarData.days.map(d => d.events.length > 0 && (
                      <div key={d.date} className="bg-slate-50 border border-slate-200 rounded-2xl p-3">
                        <div className="text-[10px] font-bold text-slate-500 uppercase tracking-wide mb-1.5">{d.label}</div>
                        <div className="space-y-1.5">
                          {d.events.map((ev, i) => (
                            <div key={i} className="flex items-start gap-2">
                              <span className="font-mono text-xs font-black text-blue-600 shrink-0 mt-0.5">{ev.time}</span>
                              <div className="min-w-0 flex-1">
                                <div className="text-xs font-bold text-slate-800 leading-snug">{ev.summary}</div>
                                {ev.location && <div className="text-[10px] text-slate-400 truncate">📍 {ev.location}</div>}
                              </div>
                            </div>
