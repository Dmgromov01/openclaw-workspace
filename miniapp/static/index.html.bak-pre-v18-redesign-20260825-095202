                👁 Войти с FaceID
              </button>
              {bioStatus && (
                <div className="text-[10px] font-semibold text-slate-500 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 max-w-60 leading-relaxed">
                  {bioStatus}
