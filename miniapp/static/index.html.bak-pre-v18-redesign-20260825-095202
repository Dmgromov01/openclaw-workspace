                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {/* 2. Запланированные дела & Архив */}
              <div className="card-white rounded-3xl p-5 space-y-4">
                <div className="flex items-center justify-between">
                  <div className="text-base font-black text-slate-900">📋 Запланированные дела</div>
                  <button
                    onClick={() => { haptic(); setView('archive'); }}
                    className="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200 hover:bg-blue-100 transition active:scale-95"
                  >
                    📦 Архив ({completedTasks.length}) →
                  </button>
                </div>

                {/* Список активных задач */}
                <div className="space-y-2">
                  {activeTasks.map(t => (
                    <div
                      key={t.id}
                      className="p-3.5 bg-slate-50 hover:bg-slate-100/80 border border-slate-200 rounded-2xl transition"
