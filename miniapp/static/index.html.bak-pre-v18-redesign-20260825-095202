                  {passState.msg && <div className="text-[10px] font-bold text-red-500">{passState.msg}</div>}
                  <button
                    onClick={doLoginPassword}
                    className="w-full py-2.5 bg-blue-600 text-white rounded-xl font-bold text-xs transition active:scale-95"
