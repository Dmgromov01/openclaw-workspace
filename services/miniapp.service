[Unit]
Description=Telegram MiniApp Personal Hub (python server, :8080)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/root/openclaw/miniapp
ExecStart=/root/openclaw/venv/bin/python /root/openclaw/miniapp/server.py
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/root/openclaw/miniapp/miniapp_server.log
StandardError=append:/root/openclaw/miniapp/miniapp_server.log
Environment=HOME=/root
Environment=PATH=/usr/bin:/bin:/usr/local/bin:/root/.local/bin

[Install]
WantedBy=default.target
