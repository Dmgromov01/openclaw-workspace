[Unit]
Description=Oura morning operational report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/openclaw/workspace/health
ExecStartPre=/usr/bin/python3 /root/openclaw/workspace/health/scripts/oura_sync.py --days 7
ExecStart=/usr/bin/python3 /root/openclaw/workspace/health/scripts/morning_report.py
StandardOutput=append:/root/openclaw/workspace/health/analysis/automation.log
StandardError=append:/root/openclaw/workspace/health/analysis/automation.err
