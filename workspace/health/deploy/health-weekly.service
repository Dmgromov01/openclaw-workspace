[Unit]
Description=Oura weekly trend and pattern report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/openclaw/workspace/health
ExecStartPre=/usr/bin/python3 /root/openclaw/workspace/health/scripts/oura_sync.py --days 14
ExecStart=/usr/bin/python3 /root/openclaw/workspace/health/scripts/weekly_report.py --scope weekly
StandardOutput=append:/root/openclaw/workspace/health/analysis/automation.log
StandardError=append:/root/openclaw/workspace/health/analysis/automation.err
